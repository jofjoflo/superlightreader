{
	"name": "reader",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"cap:sync": "pnpm run build && cap sync android",
		"android:build": "pnpm run cap:sync && cd android && ./gradlew assembleDebug",
		"android:open": "cap open android",
		"android:run": "pnpm run cap:sync && cap run android",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node --test \"src/**/*.test.ts\""
	},
	"devDependencies": {
		"@capacitor/cli": "^8.6.2",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^7.0.4"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"@capacitor/android": "^8.6.2",
		"@capacitor/core": "^8.6.2",
		"@jsquash/avif": "^2.1.1",
		"fflate": "^0.8.2",
		"idb-keyval": "^6.2.2",
		"node-unrar-js": "^2.0.2",
		"onnxruntime-web": "^1.22.0"
	}
}
